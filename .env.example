# Provider keys (optional — missing keys fall back to simulated data)
NANSEN_API_KEY=
ANTHROPIC_API_KEY=

# x402 v2 facilitator
# CDP production facilitator: set both CDP_API_KEY_ID and CDP_API_KEY_SECRET.
# Otherwise the app falls back to FACILITATOR_URL, then to the @x402/core default.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Payout wallets
WALLET_ADDRESS_BASE=0xC67d94504696960bA0f2e7C3FeE703950734c00A
WALLET_ADDRESS_SOLANA=4s8XQC2WzRfgH8Xiep7ybnCW11VKRCMwxQF6jknx3VPf
# Backward-compat fallback used when WALLET_ADDRESS_BASE is unset.
WALLET_ADDRESS=

# Wallet UI
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder

# Data providers
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
ALCHEMY_API_KEY=

# Optional: override the Claude model used for analysis
ANTHROPIC_MODEL=claude-opus-4-7

# Optional: wallet used when POST /api/portfolio/analyze is called without
# a body or without `walletAddress` (response includes `mode: "sample"`).
DEFAULT_SAMPLE_WALLET=

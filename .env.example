NANSEN_API_KEY=
ANTHROPIC_API_KEY=
WALLET_ADDRESS=
FACILITATOR_URL=https://api.developer.coinbase.com/rpc/v1/base/facilitator
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional: EVM RPC for Base / Polygon portfolio lookups
ALCHEMY_API_KEY=
# Optional: override the Claude model used for analysis
ANTHROPIC_MODEL=claude-opus-4-7

# Multi-chain payments
# Solana receiving wallet (base58) for the /solana sub-routes
SOLANA_WALLET_ADDRESS=
# JPYC v2 contract on Polygon — used by the /polygon sub-routes (?token=jpyc)
NEXT_PUBLIC_JPYC_CONTRACT=0x431D5dfF03120AFA4bDf332c61A6e1766eF37BDB
# USDT (BEP-20) contract on BNB Chain — used by the /bnb sub-routes
NEXT_PUBLIC_USDT_BNB_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# Optional: BNB Chain RPC endpoint
BNB_RPC_URL=https://bsc-dataseed.binance.org/
